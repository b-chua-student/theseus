# Commented values are optional. Remove # to use.

# Gemini
GEMINI_API_KEY=CHANGE_ME

# MongoDB (defaults shown; on Render use a MongoDB Atlas connection string)
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=mydb

# Flask
SECRET_KEY=change-me
FLASK_APP=app.py
FLASK_DEBUG=true
HOST=127.0.0.1
PORT=5000

# ChromaDB
CHROMA_PERSIST_PATH=./chroma_data

# Git (Dulwich)
GIT_REPO_DIR=./repository

# Chonkie
CHUNK_SIZE=512

# Production only (set automatically by render.yaml; leave unset for local development)
# SESSION_COOKIE_SECURE=1   # session cookie only over HTTPS
# TRUST_PROXY_HOPS=1        # number of reverse proxies in front of the app
# LOG_TO_STDOUT=1           # log to the console instead of logs/app.log
# FRONTEND_DIST=../frontend/dist   # serve the built frontend from Flask
