# Configure the hosting platform to inject SECRET_KEY from its secret store.
SECRET_KEY=
FLASK_DEBUG=0
# Set MONGODB_URI for persistent repositories. Leave it unset for a single local worker.
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=mydb
# GEMINI_API_KEY=
# Optional Gemini model for chat generation and token counting.
# GEMINI_CHAT_MODEL=gemini-3-flash-preview
# Adjust the context window if the selected model has a different input limit.
# ASSISTANT_CONTEXT_WINDOW=1048576
# SESSION_COOKIE_SECURE=1

# Optional Gunicorn bind port.
PORT=5000

# Inject OAUTH_PROVIDERS as a secret JSON object keyed by google.
# Each entry contains client_id, client_secret, redirect_uri and the trusted issuer,
# authorization_endpoint, token_endpoint and jwks_uri from its OIDC metadata.
# Register the exact HTTPS redirect_uri /api/auth/oauth/<provider>/callback.
# OAUTH_PROVIDERS={}
