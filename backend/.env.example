# Commented values are optional. Remove # to use.

# Gemini
GEMINI_API_KEY=CHANGE_ME

# Flask
SECRET_KEY=change-me
FLASK_APP=app.py
FLASK_DEBUG=true
HOST=127.0.0.1
PORT=5000

# ChromaDB
CHROMA_PERSIST_PATH=./chroma_data

# Logging
# LOG_LEVEL=INFO        # DEBUG | INFO | WARNING | ERROR | CRITICAL (default: DEBUG in debug mode, INFO otherwise)
# LOG_FILE=theseus.log  # Optional path to a rotating log file (max 10 MB, 5 backups); omit for stdout only.

# Git (Dulwich)
GIT_REPO_DIR=./repository

# Chonkie
CHUNK_SIZE=512
